		{
			"name": "Keycloak - Authentication",
			"item": [
				{
					"name": "Get Access Token (Manual)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Guardar token en variable de colección automáticamente",
									"const jsonData = pm.response.json();",
									"",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set('access_token', jsonData.access_token);",
									"    ",
									"    const expiresIn = jsonData.expires_in || 300;",
									"    const expiryTime = Date.now() + ((expiresIn - 30) * 1000);",
									"    pm.collectionVariables.set('token_expiry', expiryTime);",
									"    ",
									"    console.log('✅ Token guardado en variables de colección');",
									"    console.log('Expira en:', expiresIn, 'segundos');",
									"    ",
									"    if (jsonData.refresh_token) {",
									"        pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded",
								"type": "text"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "password",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "{{keycloak_client_id}}",
									"type": "text"
								},
								{
									"key": "username",
									"value": "{{keycloak_username}}",
									"type": "text"
								},
								{
									"key": "password",
									"value": "{{keycloak_password}}",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token",
							"host": ["{{keycloak_url}}"],
							"path": [
								"realms",
								"{{keycloak_realm}}",
								"protocol",
								"openid-connect",
								"token"
							]
						},
						"description": "Obtiene manualmente un token JWT de Keycloak.\n\n⚠️ NOTA: No es necesario ejecutar esta petición manualmente.\nLa colección obtiene el token automáticamente antes de cada petición.\n\nUsa esto solo para:\n- Ver el contenido del token\n- Depurar problemas de autenticación\n- Probar diferentes usuarios"
					},
					"response": []
				},
				{
					"name": "Get Access Token (Confidential Client)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Guardar token para clientes CONFIDENCIALES (requiere client_secret)",
									"const jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set('access_token', jsonData.access_token);",
									"    const expiresIn = jsonData.expires_in || 300;",
									"    const expiryTime = Date.now() + ((expiresIn - 30) * 1000);",
									"    pm.collectionVariables.set('token_expiry', expiryTime);",
									"    console.log('✅ Token (confidential client) guardado');",
									"    if (jsonData.refresh_token) { pm.collectionVariables.set('refresh_token', jsonData.refresh_token); }",
									"} else {",
									"    console.error('❌ No se obtuvo token para cliente confidencial');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {"type": "noauth"},
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/x-www-form-urlencoded", "type": "text"}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{"key": "grant_type", "value": "password", "type": "text"},
								{"key": "client_id", "value": "{{keycloak_client_id}}", "type": "text"},
								{"key": "client_secret", "value": "{{keycloak_client_secret}}", "type": "text"},
								{"key": "username", "value": "{{keycloak_username}}", "type": "text"},
								{"key": "password", "value": "{{keycloak_password}}", "type": "text"}
							]
						},
						"url": {
							"raw": "{{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token",
							"host": ["{{keycloak_url}}"],
							"path": ["realms", "{{keycloak_realm}}", "protocol", "openid-connect", "token"]
						},
						"description": "Usar SOLO si el cliente en Keycloak es CONFIDENTIAL y requiere client_secret. Si el cliente es PUBLIC, usar 'Get Access Token (Manual)'."
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const jsonData = pm.response.json();",
									"",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set('access_token', jsonData.access_token);",
									"    ",
									"    const expiresIn = jsonData.expires_in || 300;",
									"    const expiryTime = Date.now() + ((expiresIn - 30) * 1000);",
									"    pm.collectionVariables.set('token_expiry', expiryTime);",
									"    ",
									"    console.log('✅ Token renovado exitosamente');",
									"    ",
									"    if (jsonData.refresh_token) {",
									"        pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded",
								"type": "text"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "refresh_token",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "{{keycloak_client_id}}",
									"type": "text"
								},
								{
									"key": "refresh_token",
									"value": "{{refresh_token}}",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token",
							"host": ["{{keycloak_url}}"],
							"path": [
								"realms",
								"{{keycloak_realm}}",
								"protocol",
								"openid-connect",
								"token"
							]
						},
						"description": "Renueva el access token usando el refresh token.\n\nUso opcional - la colección maneja la renovación automáticamente."
					},
					"response": []
				},
