{
	"info": {
		"_postman_id": "library-system-2025",
		"name": "Library Management System - Complete API",
		"description": "Colección completa de APIs para el Sistema de Gestión de Biblioteca.\nTodas las peticiones se hacen a través del Gateway (puerto 8090) que redirige a los microservicios.\n\n🔐 AUTENTICACIÓN JWT:\n- Los endpoints están protegidos con Keycloak\n- Esta colección obtiene automáticamente el token JWT\n- El token se renueva automáticamente antes de cada petición\n- Usuarios de prueba configurados en variables",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "library-system"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// ⚠️ SCRIPT DESHABILITADO - Usar método manual",
					"// Para usar autenticación JWT:",
					"// 1. Ir a la carpeta 'Keycloak - Authentication'",
					"// 2. Ejecutar 'Get Access Token (Manual)'",
					"// 3. El token se guardará automáticamente en {{access_token}}",
					"",
					"console.log('Pre-request: Usando token manual desde variables');"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script para verificar respuestas de autenticación",
					"",
					"const statusCode = pm.response.code;",
					"const url = pm.request.url.toString();",
					"const hasToken = !!pm.collectionVariables.get('access_token');",
					"",
					"// Verificar si la petición falló por autenticación",
					"if (statusCode === 401) {",
					"    console.error('❌ Error 401 Unauthorized - Token inválido o expirado');",
					"    console.log('El token será renovado en la próxima petición');",
					"    // Limpiar token para forzar renovación",
					"    pm.collectionVariables.set('access_token', '');",
					"    pm.collectionVariables.set('token_expiry', 0);",
					"}",
					"",
					"if (statusCode === 403) {",
					"    console.error('❌ Error 403 Forbidden - El usuario no tiene permisos para esta operación');",
					"    console.log('Usuario actual:', pm.collectionVariables.get('keycloak_username'));",
					"}",
					"",
					"// Expectativas según autenticación para endpoints protegidos (/api/)",
					"if (url.includes('/api/')) {",
					"  if (!hasToken) {",
					"    pm.test('Sin token, debe responder 401', function () {",
					"      pm.expect(pm.response.code).to.eql(401);",
					"    });",
					"  } else {",
					"    pm.test('Con token válido, debe responder 2xx', function () {",
					"      pm.expect(pm.response.code).to.be.above(199);",
					"      pm.expect(pm.response.code).to.be.below(300);",
					"    });",
					"  }",
					"}",
					"",
					"// Log de éxito",
					"if (statusCode >= 200 && statusCode < 300) {",
					"    console.log('✅ Petición exitosa -', pm.info.requestName);",
					"}"
				]
			}
		}
	],
