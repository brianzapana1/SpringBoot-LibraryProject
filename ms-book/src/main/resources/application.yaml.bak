spring:
  application:
    name: ms-book
  config:
    import: "configserver:http://localhost:8888"
  cloud:
    config:
      enabled: true
      uri: http://localhost:8888
      fail-fast: true
      retry:
        initial-interval: 1000
        max-attempts: 6
        max-interval: 2000
        multiplier: 1.1

